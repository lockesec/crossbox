{
  "description": "crossbox: show ready work at session start; refuse direct writes under .crossbox/",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {"type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/session-start.sh\""}
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {"type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/queue-guard.py\""}
        ]
      }
    ]
  }
}
